{
  "name": "n8n-nodes-nadia",
  "version": "0.1.0",
  "description": "n8n community node for Nadia \u2014 schedule social posts, upload media, read analytics and react to publications, comments and DMs",
  "keywords": [
    "n8n-community-node-package",
    "social media",
    "scheduling",
    "instagram",
    "tiktok",
    "nadia"
  ],
  "license": "MIT",
  "homepage": "https://usenadia.com",
  "author": {
    "name": "UseNadia",
    "email": "support@usenadia.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usenadia/n8n-nodes-nadia.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "packageManager": "pnpm@10.6.1",
  "main": "dist/index.js",
  "scripts": {
    "build": "rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts nodes credentials index.ts",
    "lintfix": "ESLINT_USE_FLAT_CONFIG=false eslint --ext .ts nodes credentials index.ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "pnpm build",
    "scan": "node ../../../scripts/n8n-scan.mjs"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/NadiaApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Nadia/Nadia.node.js",
      "dist/nodes/NadiaTrigger/NadiaTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.2.5",
    "typescript": "~5.5.4"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
