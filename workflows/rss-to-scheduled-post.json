            "index": 0
          }
        ]
      ]
    },
    "Read the feed": {
      "main": [
        [
          {
            "node": "Only new items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Only new items": {
      "main": [
        [
          {
            "node": "Write the caption",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write the caption": {
