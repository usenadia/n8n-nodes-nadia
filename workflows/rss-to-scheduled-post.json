          {
            "node": "Schedule the post",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Caption model": {
      "ai_languageModel": [
        [
          {
            "node": "Write the caption",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
