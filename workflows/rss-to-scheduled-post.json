            "index": 0
          }
        ]
      ]
    },
    "Only new items": {
      "main": [
        [
          {
            "node": "Write the caption",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Write the caption": {
      "main": [
        [
          {
            "node": "Nadia",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
