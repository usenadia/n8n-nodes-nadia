    {
      "parameters": {
        "operation": "createPost",
        "channelId": "",
        "type": "schedule",
        "useFreeSlot": true,
        "content": "={{ $('Google Sheets').item.json.caption }}",
        "media": "={{ JSON.stringify([{ id: $json.id, path: $json.path }]) }}",
        "settings": {
          "mappingMode": "defineBelow",
          "value": {}
        },
        "additionalFields": {}
      },
      "id": "schedule-the-post",
      "name": "Schedule the post",
      "type": "n8n-nodes-nadia.nadia",
      "typeVersion": 1,
      "position": [
        900,
        0
      ],
      "credentials": {
        "nadiaApi": {
          "id": "REPLACE",
          "name": "Nadia account"
        }
      }
    }
  ],
